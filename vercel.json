{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/process.ts": {
      "includeFiles": "workflow/references/**",
      "maxDuration": 60
    },
    "api/generate-config.ts": {
      "maxDuration": 60
    },
    "api/ocr.ts": {
      "maxDuration": 60
    }
  }
}
