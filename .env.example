# ===========================================
# PUBLIC BROWSER CONFIGURATION
# Only these values use the VITE_ prefix
# ===========================================

# Supabase (get from your Supabase project settings)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# SERVER-ONLY CONFIGURATION (Vercel env vars)
# NEVER add VITE_ prefix to these
# ===========================================

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Gemini OCR (preferred in Vercel)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_OCR_MODEL=gemini-2.5-flash

# LM Studio OCR (your local machine via tunnel)
# Use ngrok, cloudflare tunnel, or similar to expose localhost:1234
LM_STUDIO_URL=https://your-tunnel-url.ngrok.io/v1
LM_STUDIO_OCR_MODEL=llava-llama-3

# Optional
APP_URL=https://your-app.vercel.app

# ===========================================
# MODEL ROUTER NOTES
# The model router uses these OpenRouter models:
#   Tier 1 (Free): meta-llama/llama-3.3-70b-instruct:free
#   Tier 2 (Flash): deepseek/deepseek-chat
#   Tier 3 (Pro): deepseek/deepseek-reasoner
# Free models are tried first, then auto-escalate based on confidence.
# ===========================================
